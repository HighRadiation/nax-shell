# nax yapilandirmasi — ornek dosya.
#
# KULLANIM:
#   cp nax.conf.example nax.conf
#   chmod 600 nax.conf
#   api_key satirini doldur
#
# nax.conf .gitignore icindedir; anahtar asla depoya girmez.
# Bu dosyayi yalnizca naxd okur, kabuk (C tarafi) okumaz.
# Dosya her istekte degisiklik icin kontrol edilir: kaydettigin an gecerli
# olur, kabugu yeniden baslatmak gerekmez.

# ---------------------------------------------------------------------------
# Bulut saglayici — varsayilan yol.
# provider: groq | openrouter | openai | gemini | nvidia | anthropic
# Ilk bes tanesi ayni OpenAI uyumlu bicimi konusur, tek kod yolu kullanir.
# anthropic ayri bir bicim konusur, ayri adaptor ile ele alinir.
# ---------------------------------------------------------------------------
provider       = groq
base_url       = https://api.groq.com/openai/v1
api_key        =

# ---------------------------------------------------------------------------
# Claude kullanmak icin provider = anthropic yazip su ucu ve model adlarini
# kullan. Claude ayri bir bicim konusuyor ve farklar kucuk degil: uc nokta
# "/messages", anahtar "x-api-key" basliginda, sistem istemi ust duzey bir
# alan ve SICAKLIK GONDERILMIYOR - guncel modeller sicakligi reddediyor.
# Bunlarin hepsi kod tarafinda ele alindi; burada yalnizca adres ve model
# adlari degisiyor.
#
#   provider       = anthropic
#   base_url       = https://api.anthropic.com/v1
#   model_intent   = claude-haiku-4-5
#   model_explain  = claude-opus-5
#
# Model adlari TAM olarak boyle yazilir; sonlarina tarih eklenmez.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Gorev basina model.
# Niyeti tek komuta cevirmek dar bir istir; kucuk ve hizli model daha iyidir,
# cunku burada gecikme kalitenin parcasidir. Hata aciklamak akil ister,
# buyuk model bedelini hak eder.
#
# MODEL ADLARI ESKIR: saglayicilar model kaldiriyor ve o an istek
# "404 - does not exist or you do not have access" ile doner. Ad yanlis
# oldugunda anahtar sucsuzdur; hata satiri sebebi yaziyor. Hesabinda hangi
# adlarin GECERLI oldugunu gormek icin:
#
#   curl -s -H "Authorization: Bearer $(grep '^api_key' nax.conf | \
#       cut -d= -f2 | tr -d ' ')" \
#       https://api.groq.com/openai/v1/models | grep -o '"id":"[^"]*"'
#
# Asagidakiler ornek; kendi listenden sec.
# ---------------------------------------------------------------------------
model_intent   = openai/gpt-oss-20b
model_explain  = openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Yerel model — opsiyon, temel yol degil.
# local_url'nin 127.0.0.1 olmasi ZORUNLU DEGIL. Kabuk GPU'su olmayan bir
# makinede kosarken, guclu makinede "ollama serve" calisir ve buraya o
# makinenin adresi yazilir (ornegin Tailscale adresi).
# use_local = true yazip kaydetmek yerel modele gecirir.
# ---------------------------------------------------------------------------
use_local      = false
local_url      = http://127.0.0.1:11434/v1
local_model    = qwen2.5-coder:7b

# ---------------------------------------------------------------------------
# Dusme ve sureler.
# local_fallback, bulut cagrisi iki kez ust uste patlarsa yerel modele gecer.
# Tetikleyici "internet var mi" degil, "cagri patladi mi": gercek hayatta
# API arizasi, kota bitmesi ve yavaslama, internetin gitmesinden cok daha
# sik olur ve mekanizma ayni.
# ---------------------------------------------------------------------------
local_fallback = true
timeout        = 15
spinner        = 4

# ---------------------------------------------------------------------------
# AI'in TAMAMEN kapatilacagi dizinler, iki nokta ile ayrilir.
# Calisma dizini bunlardan birinin icindeyse hicbir istek gonderilmez ve
# kullaniciya tek satir bildirilir. Hassas depolar icin.
#   ornek: ai_off_dirs = ~/musteri-islari:/opt/gizli
# Liste kabuga el sikismada bildirilir; karari kabuk veriyor, cunku
# "hic gonderme" karari gonderen tarafta olmak zorunda.
# ---------------------------------------------------------------------------
ai_off_dirs    =
